<Window x:Class="dịchMH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Loaded="MainWindow_Loaded" SizeChanged="MainWindow_SizeChanged"
        Icon="Assets/DichManHinh.ico"
        Title="Dịch màn hình" Height="700" Width="700"
        MinHeight="460" MinWidth="460" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#0C1017" Foreground="#F2F4F8">
    <ScrollViewer x:Name="MainScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Center"
                  SizeChanged="MainScrollViewer_SizeChanged">
        <Grid x:Name="PageWidthGrid" MaxWidth="816">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1B2A43" CornerRadius="12" Padding="10,6"
                            HorizontalAlignment="Left">
                        <TextBlock Text="OCR  ·  DỊCH TRỰC TIẾP" Foreground="#9BB9FF"
                                   FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Grid.Row="1" Text="Dịch màn hình" FontSize="28"
                               FontWeight="SemiBold" Margin="0,12,0,0"/>
                    <TextBlock Grid.Row="2"
                               Text="Đọc lời thoại trong game và phủ bản dịch ngay tại vị trí chữ."
                               Foreground="#AAB4C5" FontSize="14" TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </Grid>

                <Border Grid.Row="2" Background="#141B26" BorderBrush="#263245"
                        BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Thiết lập nhận diện" FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Text="Ngôn ngữ chữ trong game"
                                   FontSize="12" Foreground="#AAB4C5" Margin="0,18,0,7"/>
                        <ComboBox Grid.Row="2" x:Name="LanguageComboBox"/>

                        <Border Grid.Row="3" Background="#101620" BorderBrush="#253247"
                                BorderThickness="1" CornerRadius="10" Padding="14"
                                Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox x:Name="AutoRefreshCheckBox"
                                              Content="Tự quét màn hình" IsChecked="True"
                                              Style="{StaticResource ModernSwitch}"
                                              FontSize="14" FontWeight="Medium"/>
                                    <TextBlock Grid.Row="1"
                                               Text="Tự cập nhật bản dịch trong vùng đã chọn."
                                               Foreground="#8F9BAE" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <TextBlock Text="Chu kỳ" Foreground="#AAB4C5" FontSize="11"
                                               Margin="0,0,0,5"/>
                                    <ComboBox x:Name="ScanIntervalComboBox" Width="104"
                                              IsEnabled="{Binding IsChecked, ElementName=AutoRefreshCheckBox}"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="1 giây" Tag="1"/>
                                        <ComboBoxItem Content="2 giây" Tag="2"/>
                                        <ComboBoxItem Content="3 giây" Tag="3"/>
                                        <ComboBoxItem Content="5 giây" Tag="5"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Row="4" Background="#1A2230" CornerRadius="8"
                                Padding="11,9" Margin="0,14,0,0">
                            <TextBlock Text="Mẹo: chọn vùng nhỏ chứa lời thoại để giảm tải và quét nhanh hơn."
                                       Foreground="#AAB4C5" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="SelectAreaButton" Content="Chọn vùng trên màn hình"
                            Height="48" FontSize="15" FontWeight="SemiBold"
                            Background="#477DFA" BorderBrush="#477DFA" Padding="16,0"
                            Click="SelectAreaButton_Click"/>
                    <TextBlock Grid.Row="1" x:Name="StatusText"
                               Text="Đang kiểm tra bộ OCR của Windows..."
                               Foreground="#AAB4C5" FontSize="11" TextWrapping="Wrap"
                               Margin="2,10,2,0"/>
                    <Border Grid.Row="2" Background="#141B26" BorderBrush="#263245"
                            BorderThickness="1" CornerRadius="9" Padding="11,9"
                            Margin="0,12,0,0">
                        <TextBlock Text="Chỉ dùng OCR ảnh màn hình — không đọc bộ nhớ hay sửa game. Ảnh được xử lý trên máy; chữ nhận diện được gửi tới Google Translate."
                                   Foreground="#8996A9" FontSize="10.5" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
